# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_discovery
# Set DB_ADAPTER=pglite to run backend against in-memory PGlite (tests/dev without Postgres)
# DB_ADAPTER=
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Frontend (Vite reads VITE_* at build time)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# LLM goal parser (optional, server-side only — never expose to frontend)
# Works with any OpenAI-compatible chat-completions endpoint.
# Set AI_PROVIDER=llm to use it by default, or pass { "useLlm": true }
# per request to POST /api/v1/recommend. Rule-based stays the default.
# AI_PROVIDER=rule-based
# AI_LLM_BASE_URL=https://api.apinex.bond/v1
# AI_LLM_API_KEY=
# AI_LLM_MODEL=free/claude-sonnet-4.6
# (MiniMax also works: AI_LLM_BASE_URL=https://api.minimax.io/v1)
