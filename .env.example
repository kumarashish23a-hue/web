# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_discovery
# Set DB_ADAPTER=pglite to run backend against in-memory PGlite (tests/dev without Postgres)
# DB_ADAPTER=
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Frontend (Vite reads VITE_* at build time)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Future: LLM provider keys (server-side only, never expose to frontend)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
